# SkillTwin Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED
# =============================================================================
SKILLTWIN_ADMIN_SECRET=your-secret-here

# =============================================================================
# DATABASE
# =============================================================================
# sqlite (default) or json (legacy)
SKILLTWIN_USE_SQLITE=1
# Optional: custom DB path (default: dep_operaciones/skilltwin.db)
# SKILLTWIN_DB_PATH=
# In production, require sessions to be persisted in the database.
SKILLTWIN_REQUIRE_PERSISTENT_SESSIONS=0

# =============================================================================
# SERVER
# =============================================================================
PORT=8000
SKILLTWIN_TRUST_PROXY=0
SKILLTWIN_HSTS=0
SKILLTWIN_CORS_ORIGINS=*

# Public URL used in Stripe Checkout redirect URLs and email links
SKILLTWIN_PUBLIC_URL=http://localhost:8000

# =============================================================================
# GEMINI AI (optional - works offline without it)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# STRIPE PAYMENTS (optional - payment features disabled without it)
# =============================================================================
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# EMAIL SMTP (for contact form)
# =============================================================================
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=teamskiltwinhq@zohomail.com

# =============================================================================
# RATE LIMITING
# =============================================================================
SKILLTWIN_RATE_LIMIT_WINDOW=60
SKILLTWIN_RATE_LIMIT_MAX=30
SKILLTWIN_CACHE_TTL=300
