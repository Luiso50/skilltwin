# SkillTwin Environment Variables
# Copy this file to .env and fill in your values

# Required
SKILLTWIN_ADMIN_SECRET=your-secret-here

# Database
SKILLTWIN_USE_SQLITE=1
SKILLTWIN_DB_PATH=

# CORS
SKILLTWIN_CORS_ORIGINS=*

# Rate Limiting
SKILLTWIN_RATE_LIMIT_WINDOW=60
SKILLTWIN_RATE_LIMIT_MAX=30
SKILLTWIN_CACHE_TTL=300

# Gemini AI
GEMINI_API_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
SKILLTWIN_PUBLIC_URL=http://localhost:8000

# Email SMTP Configuration (for contact form)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=teamskiltwinhq@zohomail.com

# Server
PORT=8000
SKILLTWIN_TRUST_PROXY=0
SKILLTWIN_HSTS=0
