# SkillTwin Environment Variables
# Copy this file to .env and fill in your values

# Gemini AI API Key (optional - works offline without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Admin Authentication (REQUIRED - server won't start without it)
# NEVER use trivial values like "skilltwin-dev-2026" - generate a secure one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SKILLTWIN_ADMIN_SECRET=

# Database Mode: sqlite (default) or json (legacy)
SKILLTWIN_USE_SQLITE=1

# Email SMTP Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@skilltwin.com

# Stripe Payment Integration (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Server Configuration
PORT=8000
HOST=0.0.0.0
